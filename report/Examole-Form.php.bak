$i=0;
while ($i < $num_rows)
{
	$result = mysql_fetch_array($dbquery);
	$monthpay = trim($result[0]);
	$fire = $result[1];
	$water = $result[2];
	$tel = $result[3];
	$post =  $result[4];
	$oil =  $result[5];
	$note =  $result[6];
	$foryear =  $result[7];
	$id =  $result[8];
	$fireunit =  $result[9];
	$waterunit =  $result[10];
	$oilunit =  $result[11];
	$num_person =  $result[12];
	$area_in =  $result[13];
	$work_hour =  $result[14];
	$customer =  $result[15];
	$area_service =  $result[16];
	$out_area =  $result[17];

// คำนวณยอดสะสม
