// save to database //
function addhistorydetail($user_login_, $operate_, $budget_note_, $ip_) {
    $date1 = date("d/m/Y H:i:s");
    $sqladdhistorydetail = "INSERT INTO `history_detail` (`id_login` , `user_login` , `date_time` , `operate` , `budget_note`, `ip`)VALUES('',  '$user_login_','$date1', '$operate_', '$budget_note_', '$ip_')";
    $result_detail = mysql_query($sqladdhistorydetail);
}
